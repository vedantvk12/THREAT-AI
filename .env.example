# ==============================================================================
# SENTINEL X / THREAT-AI — Environment Configuration Template
# ==============================================================================
# Copy this file to .env and fill in your actual values:
#   cp .env.example .env
# ==============================================================================

# Groq API Key for Cognitive Agent & Commander Copilot Reasoning (Llama 3.3 70B)
# Obtain your free API key at: https://console.groq.com/keys
GROQ_API_KEY=gsk_your_groq_api_key_here

# LLM Model Identifier (Defaults to llama-3.3-70b-versatile)
GROQ_MODEL=llama-3.3-70b-versatile

# ZeroMQ Pub/Sub Broker Configuration
ZMQ_PUB_PORT=5555
ZMQ_SUB_PORT=5556

# FastAPI WebSocket & REST Gateway Configuration
GATEWAY_HOST=0.0.0.0
GATEWAY_PORT=8000

# Computer Vision & Anomaly Detection Tuning
VISION_CONF_THRESHOLD=0.20
PRIVACY_MODE=False

# Audio Anomaly Threshold
AUDIO_THRESHOLD=0.20
AUDIO_SAMPLE_RATE=16000
